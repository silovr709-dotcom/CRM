# Сайт приложения на своём домене.
#
# Намеренно без RewriteEngine и редиректов: на reg.ru прежний набор правил
# (форс HTTPS + проброс Authorization в PHP + fallback на index.html) давал
# HTTP 500 на всех файлах папки, включая статику. Приложению перезаписи не
# нужны: роутинг — по хэшу (#/...), index.html отдаётся как DirectoryIndex,
# api/ — настоящие файлы. Вход при этом не страдает: сессия подтверждается
# cookie и заголовком X-Auth-Token, которые PHP видит без проброса.
# Принудительный HTTPS при желании включается в панели хостинга
# (Сайты → домен → SSL / «перенаправлять на HTTPS»), а не здесь.
#
# Единственное, что здесь осталось, — кэш: оболочка и service worker должны
# проверяться при каждом открытии, иначе телефон «не увидит обновлений»;
# хэшированные ассеты можно держать в кэше долго.

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>

<FilesMatch "(^sw\.js$|^index\.html$)">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </IfModule>
</FilesMatch>
