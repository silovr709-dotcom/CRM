# Пример переменных окружения. НАСТОЯЩИЕ значения в GitHub не кладём —
# они задаются в панели хостинга (Timeweb Cloud → Приложение → Переменные).
# Локально можно скопировать этот файл в .env (он в .gitignore).

# --- обязательные в облаке ---
ADMIN_LOGIN=admin                 # логин администратора при самом первом запуске
ADMIN_PASSWORD=                   # его пароль; если пусто — будет временный "admin"
DATA_DIR=/data                    # где лежат база и вложения (постоянный диск)
PORT=3000                         # порт приложения внутри контейнера
TZ=Europe/Moscow                  # часовой пояс (напоминания, брифинги)
NODE_ENV=production

# --- необязательные ---
CORS_ORIGINS=                     # домены фронтенда, если он на отдельном адресе
BACKUP_EVERY_HOURS=24             # как часто делать резервную копию базы (0 — выключить)
BACKUP_KEEP=7                     # сколько копий хранить
DISABLE_CSP=                      # 1 — отключить политику безопасности контента (для отладки)

# Telegram-токен здесь НЕ указывается: каждый пользователь вводит свой
# в приложении («Ещё → Настройки → Telegram»), он хранится в базе.
