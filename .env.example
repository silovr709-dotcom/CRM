# Пример переменных окружения. НАСТОЯЩИЕ значения в GitHub не кладём —
# они задаются в панели хостинга (Timeweb Cloud → Приложение → Переменные).
# Локально можно скопировать этот файл в .env (он в .gitignore).

# --- обязательные в облаке ---
ADMIN_LOGIN=admin                 # логин администратора при самом первом запуске
ADMIN_PASSWORD=                   # его пароль; если пусто — будет временный "admin"
DATA_DIR=/data                    # рабочая папка для базы и вложений
PORT=3000                         # порт приложения внутри контейнера
TZ=Europe/Moscow                  # часовой пояс (напоминания, брифинги)
NODE_ENV=production

# --- облачное хранилище S3 (обязательно для Timeweb App Platform!) ---
# В App Platform каждый деплой создаёт новый пустой контейнер, поэтому база
# хранится снимками в S3: при старте скачивается, при остановке выгружается.
S3_BUCKET=                        # имя бакета, например myday-data
S3_ENDPOINT=https://s3.twcstorage.ru
S3_REGION=ru-1
S3_ACCESS_KEY=                    # ключ доступа из панели S3
S3_SECRET_KEY=                    # секретный ключ из панели S3
SNAPSHOT_EVERY_MIN=5              # как часто выгружать снимок базы (0 — только при остановке)
S3_SNAPSHOT_KEY=snapshots/organizer.db

# --- необязательные ---
CORS_ORIGINS=                     # домены фронтенда, если он на отдельном адресе
BACKUP_EVERY_HOURS=24             # локальные резервные копии базы (0 — выключить)
BACKUP_KEEP=7                     # сколько локальных копий хранить
DISABLE_CSP=                      # 1 — отключить политику безопасности контента (для отладки)

# Telegram-токен здесь НЕ указывается: каждый пользователь вводит свой
# в приложении («Ещё → Настройки → Telegram»), он хранится в базе.
